# Database (local dev uses SQLite; path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Email (Resend). If RESEND_API_KEY is empty, emails are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="MassRecruit <noreply@yourdomain.edu>"

# Auth (username + password)
AUTH_SECRET="change-me-to-a-long-random-string"
ALLOWED_EMAIL_DOMAIN="edu"

# Admin bootstrap: sign-ups with these emails become ADMIN accounts
ADMIN_EMAILS="you@umb.edu"

# Cron protection: GET /api/cron/reminders requires "Authorization: Bearer $CRON_SECRET"
CRON_SECRET="change-me"

# App URL used in email links
APP_URL="http://localhost:3000"

# File storage (Phase 1b — not used yet)
BLOB_READ_WRITE_TOKEN=""
