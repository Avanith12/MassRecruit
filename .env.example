# Database — PostgreSQL.
# Local: `npm run db:start` runs Postgres on port 5433 with this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/massrecruit"
# Production (Neon / Vercel Postgres / Supabase / Railway…): use the provider's
# connection string with TLS, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connection_limit=5"

# Email (Resend). If RESEND_API_KEY is empty, emails are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="MassRecruit <noreply@yourdomain.edu>"

# Auth (username + password)
# Generate with: openssl rand -hex 32   (production refuses values < 32 chars or containing "change-me")
AUTH_SECRET="change-me-to-a-long-random-string"
ALLOWED_EMAIL_DOMAIN="edu"

# Admin bootstrap: sign-ups with these emails become ADMIN accounts (use emails you control)
ADMIN_EMAILS="you@umb.edu"

# Cron protection: GET /api/cron/reminders requires "Authorization: Bearer $CRON_SECRET"
CRON_SECRET="change-me"

# App URL used in email links
APP_URL="http://localhost:3000"

# Consent PDF storage. Set for production (Vercel Blob); empty → saved to ./uploads/consent
BLOB_READ_WRITE_TOKEN=""
# UPLOAD_DIR="./uploads/consent"

# Seeding a hosted database (deletes all data!):
#   SEED_CONFIRM=yes SEED_PASSWORD="<12+ char secret for the 4 demo accounts>" npm run db:seed
